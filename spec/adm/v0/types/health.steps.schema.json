{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "Steps taken during the interval.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "description": "Number of steps.",
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "count"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.steps"
    }
  },
  "required": [
    "end_ms"
  ],
  "title": "health.steps",
  "x-sensitivity": "high"
}
