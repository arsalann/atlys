{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "A location fix.",
  "not": {
    "required": [
      "end_ms"
    ]
  },
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "altitude_m": {
          "description": "Altitude above sea level in meters.",
          "type": "number"
        },
        "course_accuracy_deg": {
          "description": "Course uncertainty in degrees.",
          "minimum": 0,
          "type": "number"
        },
        "course_deg": {
          "description": "Direction of travel in degrees from true north.",
          "maximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "ellipsoidal_altitude_m": {
          "description": "Altitude above the WGS84 ellipsoid in meters.",
          "type": "number"
        },
        "floor": {
          "description": "Building floor, when known.",
          "type": "integer"
        },
        "from_accessory": {
          "description": "The location came from an external accessory.",
          "type": "boolean"
        },
        "horizontal_accuracy_m": {
          "description": "Radius of uncertainty in meters.",
          "minimum": 0,
          "type": "number"
        },
        "latitude": {
          "description": "WGS84 latitude in degrees.",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "longitude": {
          "description": "WGS84 longitude in degrees.",
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        "simulated": {
          "description": "The location was simulated by software.",
          "type": "boolean"
        },
        "speed_accuracy_mps": {
          "description": "Speed uncertainty in meters per second.",
          "minimum": 0,
          "type": "number"
        },
        "speed_mps": {
          "description": "Speed in meters per second.",
          "minimum": 0,
          "type": "number"
        },
        "trigger": {
          "description": "What delivered the fix.",
          "enum": [
            "significant_change",
            "foreground",
            "detailed",
            "visit"
          ]
        },
        "vertical_accuracy_m": {
          "description": "Altitude uncertainty in meters.",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "horizontal_accuracy_m"
      ],
      "type": "object"
    },
    "type": {
      "const": "location.point"
    }
  },
  "title": "location.point",
  "x-sensitivity": "high"
}
