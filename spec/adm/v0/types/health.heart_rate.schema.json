{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "A heart rate sample.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "bpm": {
          "description": "Beats per minute.",
          "exclusiveMinimum": 0,
          "maximum": 300,
          "type": "number"
        }
      },
      "required": [
        "bpm"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.heart_rate"
    }
  },
  "title": "health.heart_rate",
  "x-sensitivity": "high"
}
