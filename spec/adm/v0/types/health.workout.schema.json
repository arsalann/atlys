{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "A workout.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "activities": {
          "description": "Sub-activities of multisport workouts."
        },
        "activity_name": {
          "description": "Name of the activity type, when Atlys knows it.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "activity_type": {
          "description": "Raw HKWorkoutActivityType value.",
          "minimum": 0,
          "type": "integer"
        },
        "duration_s": {
          "description": "Duration in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "events": {
          "description": "Workout events such as pauses, laps, and segments."
        },
        "metadata": {
          "description": "HealthKit metadata, as-is. Dates become epoch milliseconds and quantities `{value, unit}`.",
          "type": "object"
        },
        "statistics": {
          "description": "Per quantity type: sum, average, minimum, maximum, and unit.",
          "type": "object"
        }
      },
      "required": [
        "activity_type",
        "duration_s"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.workout"
    }
  },
  "required": [
    "end_ms"
  ],
  "title": "health.workout",
  "x-sensitivity": "high"
}
