{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "Distance covered during the interval.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "description": "How the distance was covered.",
          "enum": [
            "walking_running",
            "cycling",
            "swimming",
            "wheelchair",
            "downhill_snow_sports"
          ]
        },
        "meters": {
          "description": "Distance in meters.",
          "maximum": 10000000,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "meters",
        "activity"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.distance"
    }
  },
  "required": [
    "end_ms"
  ],
  "title": "health.distance",
  "x-sensitivity": "high"
}
