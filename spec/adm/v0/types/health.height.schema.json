{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "A height measurement.",
  "not": {
    "required": [
      "end_ms"
    ]
  },
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "m": {
          "description": "Height in meters.",
          "exclusiveMinimum": 0,
          "maximum": 3,
          "type": "number"
        }
      },
      "required": [
        "m"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.height"
    }
  },
  "title": "health.height",
  "x-sensitivity": "high"
}
