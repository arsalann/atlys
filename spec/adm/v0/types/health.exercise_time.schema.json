{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "Exercise time during the interval.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "description": "Exercise time in seconds.",
          "maximum": 10000000,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "seconds"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.exercise_time"
    }
  },
  "required": [
    "end_ms"
  ],
  "title": "health.exercise_time",
  "x-sensitivity": "high"
}
