{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "Energy burned during the interval.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "kcal": {
          "description": "Energy in kilocalories.",
          "maximum": 100000,
          "minimum": 0,
          "type": "number"
        },
        "kind": {
          "description": "Active or basal (resting) energy.",
          "enum": [
            "active",
            "basal"
          ]
        }
      },
      "required": [
        "kcal",
        "kind"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.energy"
    }
  },
  "required": [
    "end_ms"
  ],
  "title": "health.energy",
  "x-sensitivity": "high"
}
