{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "A stay at one place. `end_ms` is absent until the departure is known.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "horizontal_accuracy_m": {
          "description": "Radius of uncertainty in meters.",
          "minimum": 0,
          "type": "number"
        },
        "latitude": {
          "description": "WGS84 latitude in degrees.",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "longitude": {
          "description": "WGS84 longitude in degrees.",
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "horizontal_accuracy_m"
      ],
      "type": "object"
    },
    "type": {
      "const": "location.visit"
    }
  },
  "title": "location.visit",
  "x-sensitivity": "high"
}
