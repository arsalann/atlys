{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "A segment of sleep analysis.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "description": "Sleep stage.",
          "enum": [
            "in_bed",
            "asleep_unspecified",
            "asleep_core",
            "asleep_deep",
            "asleep_rem",
            "awake"
          ]
        }
      },
      "required": [
        "stage"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.sleep_stage"
    }
  },
  "required": [
    "end_ms"
  ],
  "title": "health.sleep_stage",
  "x-sensitivity": "high"
}
