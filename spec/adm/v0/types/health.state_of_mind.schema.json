{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../record-draft.schema.json"
    }
  ],
  "description": "A logged emotion or mood.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "associations": {
          "description": "Raw association codes."
        },
        "kind": {
          "description": "Raw kind: momentary emotion or daily mood.",
          "type": "integer"
        },
        "labels": {
          "description": "Raw label codes."
        },
        "metadata": {
          "description": "HealthKit metadata, as-is. Dates become epoch milliseconds and quantities `{value, unit}`.",
          "type": "object"
        },
        "valence": {
          "description": "From -1 (very unpleasant) to 1 (very pleasant).",
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "valence"
      ],
      "type": "object"
    },
    "type": {
      "const": "health.state_of_mind"
    }
  },
  "title": "health.state_of_mind",
  "x-sensitivity": "high"
}
