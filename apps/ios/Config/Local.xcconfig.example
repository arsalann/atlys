// Copy to Local.xcconfig (gitignored) and fill in your own values.
// Never commit Local.xcconfig: it identifies your Apple Developer account.

// Your Apple Developer team ID (10 characters, from developer.apple.com).
DEVELOPMENT_TEAM = ABCDE12345

// A reverse-DNS prefix you control. App IDs become <prefix>.app, <prefix>.spike, ...
ATLYS_BUNDLE_ID_PREFIX = com.example.yourname.atlys
